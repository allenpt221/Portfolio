{
  "compilerOptions": {
    "target": "ES2022",             
    "module": "ESNext",                 
    "lib": ["ES2022", "DOM"],           
    "moduleResolution": "bundler",       
    "jsx": "react-jsx",                  
    "strict": true,                      
    "skipLibCheck": true,               
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vite/client"]             // ensure import.meta.env works
  },
  "include": ["src", "vite.config.ts"]
}
